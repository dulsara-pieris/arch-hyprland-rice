configuration {
        show-icons: true;
        font: "JetBrainsMono Nerd Font 11";
}

* {
        background: #241D27;
        surface: #302532;
        surface-hover: #3B3040;

        foreground: #FFF3E8;
        foreground-dim: #D4C2CE;

        accent: #E8A6C8;
        accent-soft: #E8A6C825;
        accent-border: #E8A6C880;

        lavender: #CDB4E9;
        blue: #A9D8F0;
        mint: #B8DDBF;
        peach: #F1B89D;
        butter: #F3DFA5;

        transparent: #00000000;
}


/* =========================================================
   MAIN WINDOW
========================================================= */

window {
        width: 78%;
        height: 78%;

        background-color: @background;

        border: 2px;
        border-color: @accent-border;
        border-radius: 22px;

        padding: 0px;
}


/* =========================================================
   LAYOUT
========================================================= */

mainbox {
        orientation: vertical;

        background-color: @background;

        children: [
                listview
        ];

        padding: 24px;
}


/* =========================================================
   WALLPAPER GRID
========================================================= */

listview {
        columns: 4;
        lines: 3;

        spacing: 16px;

        background-color: @transparent;

        scrollbar: false;
        fixed-height: false;
        dynamic: true;
}


/* =========================================================
   WALLPAPER CARDS
========================================================= */

element {
        orientation: vertical;

        background-color: @surface;

        border: 1px;
        border-color: #E8A6C812;
        border-radius: 16px;

        padding: 7px;

        spacing: 0px;
}

element normal {
        background-color: @surface;
}

element alternate {
        background-color: @surface;
}


/* =========================================================
   SELECTED WALLPAPER
========================================================= */

element selected {
        background-color: @accent-soft;

        border: 2px;
        border-color: @accent;

        padding: 6px;
}


/* =========================================================
   IMAGES
========================================================= */

element-icon {
        size: 170px;

        background-color: @transparent;

        border-radius: 11px;

        horizontal-align: 0.5;
}


/* =========================================================
   HIDE FILENAMES
========================================================= */

element-text {
        enabled: false;
}


/* =========================================================
   SCROLLBAR
========================================================= */

scrollbar {
        width: 4px;

        background-color: @transparent;
}

scrollbar handle {
        width: 4px;

        background-color: @accent;

        border-radius: 4px;
}