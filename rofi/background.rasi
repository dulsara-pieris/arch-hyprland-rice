configuration {
        show-icons: true;
        font: "JetBrainsMono Nerd Font 11";
}

* {
        background: #050505;
        surface: #0d0d10;
        surface-hover: #16161b;

        foreground: #f5f5f7;

        accent: #ff79c6;
        accent-soft: #ff79c625;
        accent-border: #ff79c680;

        transparent: #00000000;
}

/* Main window */

window {
        width: 78%;
        height: 78%;

        background-color: @background;

        border: 2px;
        border-color: @accent-border;
        border-radius: 22px;

        padding: 0px;
}

/* Layout */

mainbox {
        orientation: vertical;

        background-color: @background;

        children: [
                listview
        ];

        padding: 24px;
}

/* Wallpaper grid */

listview {
        columns: 4;
        lines: 3;

        spacing: 16px;

        background-color: @transparent;

        scrollbar: false;
        fixed-height: false;
        dynamic: true;
}

/* Cards */

element {
        orientation: vertical;

        background-color: @surface;

        border: 1px;
        border-color: #ffffff0a;
        border-radius: 16px;

        padding: 7px;

        spacing: 0px;
}

element normal {
        background-color: @surface;
}

element alternate {
        background-color: @surface;
}

/* Selected wallpaper */

element selected {
        background-color: @accent-soft;

        border: 2px;
        border-color: @accent;

        padding: 6px;
}

/* Images */

element-icon {
        size: 170px;

        background-color: @transparent;

        border-radius: 11px;

        horizontal-align: 0.5;
}

/* Hide filenames */

element-text {
        enabled: false;
}

/* Scrollbar */

scrollbar {
        width: 4px;

        background-color: @transparent;
}

scrollbar handle {
        width: 4px;

        background-color: @accent;

        border-radius: 4px;
}