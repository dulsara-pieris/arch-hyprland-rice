/* =========================================================
   SOFT MIDNIGHT ♡ — ROFI

   Palette:
   Background  #241D27
   Surface     #302532
   Text        #FFF3E8
   Dim         #D4C2CE
   Pink        #E8A6C8
   Lavender    #CDB4E9
   Purple      #BDA7D9
   Blue        #A9D8F0
   Mint        #B8DDBF
   Peach       #F1B89D
   Butter      #F3DFA5
   Border      #604D61
========================================================= */

configuration {
    font: "Fredoka Medium 13";
    prompt: "♡";
}


/* =========================================================
   GLOBAL
========================================================= */

* {
    background-color: transparent;
    text-color: #FFF3E8;
}


/* =========================================================
   WINDOW
========================================================= */

window {
    location: center;
    anchor: center;

    width: 620px;
    height: 430px;

    background-color: #241D27;

    border: 2px;
    border-color: #E8A6C8;
    border-radius: 24px;

    padding: 24px;
}


/* =========================================================
   MAIN BOX
========================================================= */

mainbox {
    orientation: vertical;
    spacing: 18px;

    background-color: #241D27;
}


/* =========================================================
   SEARCH BAR
========================================================= */

inputbar {
    background-color: #302532;

    border: 1px;
    border-color: #604D61;
    border-radius: 16px;

    padding: 12px 16px;

    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;

    text-color: #E8A6C8;

    padding: 0px 10px 0px 0px;
}

entry {
    background-color: transparent;

    text-color: #FFF3E8;
    placeholder-color: #D4C2CE;
}


/* =========================================================
   APP LIST
========================================================= */

listview {
    columns: 1;
    lines: 6;

    fixed-height: true;

    spacing: 8px;
    scrollbar: false;

    background-color: #241D27;

    padding: 2px;
}


/* =========================================================
   APP ELEMENT BASE
========================================================= */

element {
    orientation: horizontal;

    padding: 10px 14px;

    spacing: 12px;

    border: 0px;
    border-radius: 14px;

    background-color: #241D27;

    text-color: #FFF3E8;
}


/* =========================================================
   NORMAL ROWS
========================================================= */

element normal.normal {
    background-color: #241D27;
    text-color: #FFF3E8;
}

element alternate.normal {
    background-color: #241D27;
    text-color: #FFF3E8;
}


/* =========================================================
   ACTIVE ROWS
========================================================= */

element normal.active {
    background-color: #241D27;
    text-color: #FFF3E8;
}

element alternate.active {
    background-color: #241D27;
    text-color: #FFF3E8;
}


/* =========================================================
   URGENT ROWS
========================================================= */

element normal.urgent {
    background-color: #241D27;
    text-color: #FFF3E8;
}

element alternate.urgent {
    background-color: #241D27;
    text-color: #FFF3E8;
}


/* =========================================================
   SELECTED ROW
========================================================= */

element selected.normal {
    background-color: #302532;

    border: 1px;
    border-color: #E8A6C8;
    border-radius: 14px;

    text-color: #E8A6C8;
}

element selected.active {
    background-color: #302532;

    border: 1px;
    border-color: #E8A6C8;
    border-radius: 14px;

    text-color: #E8A6C8;
}

element selected.urgent {
    background-color: #302532;

    border: 1px;
    border-color: #E8A6C8;
    border-radius: 14px;

    text-color: #E8A6C8;
}


/* =========================================================
   TEXT
========================================================= */

element-text {
    background-color: transparent;

    text-color: #FFF3E8;
}

element normal.normal element-text,
element alternate.normal element-text,
element normal.active element-text,
element alternate.active element-text,
element normal.urgent element-text,
element alternate.urgent element-text {
    background-color: transparent;

    text-color: #FFF3E8;
}

element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
    background-color: transparent;

    text-color: #E8A6C8;
}


/* =========================================================
   ICONS
========================================================= */

element-icon {
    background-color: transparent;

    size: 28px;
}


/* =========================================================
   SCROLLBAR
========================================================= */

scrollbar {
    background-color: #241D27;

    width: 4px;
}

scrollbar handle {
    background-color: #E8A6C8;

    border-radius: 4px;
}


/* =========================================================
   MESSAGE
========================================================= */

message {
    background-color: #241D27;

    padding: 0px;
}

textbox {
    background-color: transparent;

    text-color: #D4C2CE;
}


/* =========================================================
   ERROR
========================================================= */

error-message {
    background-color: #302532;

    border: 1px;
    border-color: #E8A6C8;
    border-radius: 14px;

    padding: 12px;

    text-color: #FFF3E8;
}